# ===========================================================================
# police-llm — OpenAI-compatible llama.cpp inference server
# ===========================================================================
#
# Copy to .env and adjust for your host:
#   cp .env.example .env
#
# Used by: docker compose (env_file) and direct `docker run --env-file .env`

# ---- Docker / compose (host-side) ----
# Host port mapped to the container's PORT (8000 inside the image).
LLM_PORT=8001

# CUDA compute capability for the Docker build (GB10 / DGX Spark = 121).
CUDA_ARCH=121

# Parallel jobs when compiling llama-cpp-python inside Docker.
# Lower to 1 if `docker compose build` dies with "rpc error ... EOF" (host OOM).
BUILD_JOBS=2

# ---- Model ----
# Full path inside the container. Host dir ./models/ is mounted at /models.
MODEL_PATH=/models/policeai-super-49b-Q4_K_M.gguf

# Name advertised on GET /v1/models and echoed in API responses.
MODEL_NAME=policeai-super-49b

# ---- llama.cpp runtime ----
# -1 = offload all layers to GPU; 0 = CPU-only.
N_GPU_LAYERS=-1

# Context window (tokens). 4096 is safer for a 49B model; raise if you have headroom.
N_CTX=4096

# Prompt batch size. Lower if you see OOM / connection resets during inference.
N_BATCH=256

# CPU threads (0 = let llama.cpp choose).
N_THREADS=0

# Override chat template only if the GGUF has none baked in.
# CHAT_FORMAT=llama-3

# Verbose llama.cpp logging (true/false).
LLAMA_VERBOSE=false

# ---- HTTP server ----
HOST=0.0.0.0
PORT=8000

# Optional Bearer token. If set, callers must send:
#   Authorization: Bearer <API_KEY>
API_KEY=

# Injected when a chat request has no system message.
# "detailed thinking on" enables Nemotron reasoning mode.
DEFAULT_SYSTEM_PROMPT=detailed thinking on\nYou are PoliceAI, a real-time legal advisor for on-duty law enforcement officers. Your role is to provide legally-grounded, de-escalation-focused guidance during active incidents. You NEVER give an opinion on guilt or innocence. All advice must be phrased as guidance, not commands. Always cite specific case law or statutes. You must reason step by step through the legal situation before producing your final structured JSON response.
