# ===========================================================================
# Dataset builder (generate_dataset.py) — loaded via python-dotenv
# ===========================================================================
#
# Preferred: a LiteLLM (OpenAI-compatible) gateway. If LITELLM_API_KEY is set,
# generation uses it; otherwise it falls back to the native Anthropic API.
LITELLM_API_KEY=
LITELLM_BASE_URL=https://llm-gateway.i.ai.gov.uk
LITELLM_MODEL=gemini-2.5-flash-uk

# Fallback: native Anthropic API.
ANTHROPIC_API_KEY=
GEN_MODEL=claude-opus-4-8

# ===========================================================================
# Patrol Assist app (FastAPI backend + Next.js frontend)
# ===========================================================================

# ---- Host ports (override to avoid collisions with other local stacks) ----
WEB_PORT=3000
API_PORT=8000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Backend ----
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# AI provider selection: "stub" (deterministic) | "live" (NIM + ElevenLabs)
AI_BACKEND=stub

# NVIDIA NIM (build.nvidia.com) — used when AI_BACKEND=live
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ElevenLabs — STT/TTS (shared by the app and the dataset builder's voice pipeline)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# Object storage (MinIO / S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=evidence

# ---- Frontend ----
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000
