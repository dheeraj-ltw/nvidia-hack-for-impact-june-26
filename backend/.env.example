# Local-dev overrides for running the backend natively (outside Docker).
# pydantic-settings loads this from the backend/ working directory.
# Copy to .env and fill in the keys:  cp backend/.env.example backend/.env
#
# (The repo-root .env is the source of truth for Docker Compose; this file only matters when
#  you run the backend directly with `uv run uvicorn app.main:app --reload`.)

# MinIO runs in Docker, published on host port 9000 (see `docker ps`).
S3_ENDPOINT=http://localhost:9000
CORS_ORIGINS=http://localhost:3000

# AI provider: "stub" (deterministic, no keys) or "live" (real ElevenLabs + Nebius).
AI_BACKEND=live

# ElevenLabs — speech-to-text + text-to-speech (required for AI_BACKEND=live).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: pin STT language so noise isn't tagged in random languages. Blank = auto-detect.
# ELEVENLABS_STT_LANGUAGE=eng

# Nebius Token Factory — hosted Qwen2.5-VL (video understanding) + Nemotron scene compiler.
NEBIUS_API_KEY=
# Optional overrides (defaults are fine):
# NEBIUS_SCENE_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# NEBIUS_SCENE_MODEL=nvidia/nemotron-3-super-120b-a12b

# Reasoner (optional): point at a running OpenAI-compatible police-llm to enable live guidance.
# Left unset, reason() degrades gracefully (no guidance).
# POLICEAI_BASE_URL=http://localhost:8001/v1
