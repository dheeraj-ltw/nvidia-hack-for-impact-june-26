#
# Copy to .env and adjust. Consumed by compose.yml, entrypoint.sh, and the orchestrator (config.py).

# --- Model + vLLM serving (read by entrypoint.sh) ---
VLM_MODEL=llava-hf/llava-v1.6-mistral-7b-hf
VLM_DEVICE_ID=0
GPU_MEM_UTIL=0.85
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=4

# --- Orchestrator (read by app/config.py) ---
LLAVA_PORT=8900
SAMPLE_FPS=1
CHUNK_SECONDS=10
MAX_FRAMES=8
MAX_TOKENS=512
CAPTION_CONCURRENCY=2
REQUEST_TIMEOUT=120

# --- Optional: Hugging Face token (only needed for gated models) ---
HF_TOKEN=
